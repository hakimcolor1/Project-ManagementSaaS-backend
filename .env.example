NODE_ENV=development
PORT=5000
# Public base URL of this API (used for Google and SSLCommerz callback URLs)
APP_URL=http://localhost:5000
# Comma-separated list of allowed origins, or * for any
CORS_ORIGINS=*

# PostgreSQL connection string. Keep "&schema=tasknest" at the end:
# all TaskNest tables live in that Postgres schema.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require&schema=tasknest

# Seed script (demo admin account)
ADMIN_EMAIL=admin@tasknest.com
ADMIN_PASSWORD=change-me
