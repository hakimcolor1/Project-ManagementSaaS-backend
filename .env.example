NODE_ENV=development
PORT=5000
# Public base URL of this API (used for Google and SSLCommerz callback URLs)
APP_URL=http://localhost:5000
# Comma-separated list of allowed origins, or * for any
CORS_ORIGINS=*

# PostgreSQL connection string. Keep "&schema=tasknest" at the end:
# all TaskNest tables live in that Postgres schema.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require&schema=tasknest

# Seed script (demo admin account)
ADMIN_EMAIL=admin@tasknest.com
ADMIN_PASSWORD=change-me

# Auth (JWT). Use long random secrets (at least 32 characters), different for each.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-for-access-tokens
JWT_REFRESH_SECRET=replace-with-a-long-random-secret-for-refresh-tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Google Cloud Console > Credentials > OAuth client ID > Web application).
# Authorized redirect URI: <APP_URL>/api/v1/auth/google/callback
# Leave empty to switch Google login off (it then answers 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
